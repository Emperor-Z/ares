# Copy this to .env and fill in your values.
# .env is gitignored — never commit secrets.

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# ARES_OLLAMA_HOST=http://localhost:11434
# ARES_ORCHESTRATOR_MODEL=qwen3.5:4b
# ARES_CODER_MODEL=qwen2.5-coder:7b
# ARES_THINKER_MODEL=deepseek-r1:7b
# ARES_RUNNER_MODEL=qwen2.5-coder:3b
# ARES_TRACE_DB_PATH=/home/user/.ares/traces.db

# Project Serena attaches to (defaults to the directory you launch ares from)
# ARES_SERENA_PROJECT=/path/to/your/project

# Long-term memory (needs: uv pip install -e ".[memory]" and `ollama pull nomic-embed-text`)
# ARES_MEMORY=0                        # turn it off
# ARES_MEMORY_DIR=/home/user/.ares/memory
# ARES_MEMORY_MODEL=qwen2.5-coder:3b   # model that extracts facts after each reply
